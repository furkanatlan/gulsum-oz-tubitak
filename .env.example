# Bu dosyayı ".env" adıyla kopyalayın:  copy .env.example .env
# .env dosyası git'e GÖNDERİLMEZ.

POSTGRES_USER=sulama
POSTGRES_PASSWORD=sulama123
POSTGRES_DB=sulama

# Pompanın tek vana açıkken dakikada verdiği su (ml/dk).
# Kalibrasyon deneyinden sonra güncellenecek (bkz. PROJE_PLANI.md, Adım 3).
POMPA_DEBI_ML_DK=1000

# Bilgisayardaki port numaraları. Başka bir program aynı portu kullanıyorsa
# (hata: "port is already allocated") sadece buradaki sayıyı değiştirin.
MQTT_PORT_DIS=1883
BACKEND_PORT_DIS=8000
WEB_PORT_DIS=5173
JUPYTER_PORT_DIS=8888
